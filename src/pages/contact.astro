---
import BaseLayout from "../layouts/baseLayout.astro";
const pageTitle = "Contacto | Restaurante Ixmucare";
---

<BaseLayout pageTitle={pageTitle}>
    <section class="bg-[#dad7cd] py-16 text-center">
        <h1
            class="text-4xl md:text-6xl font-serif font-bold text-[#344e41] mb-4"
        >
            Contáctanos
        </h1>
        <p class="text-xl text-[#588157]">Estamos listos para atenderte</p>
    </section>

    <div
        class="max-w-6xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-12"
    >
        <!-- Contact Info -->
        <div>
            <h2 class="text-3xl font-serif font-bold text-[#3a5a40] mb-6">
                Información
            </h2>
            <div class="space-y-6 text-lg text-gray-700">
                <div class="flex items-start">
                    <span class="text-2xl mr-4">📍</span>
                    <div>
                        <p class="font-bold text-[#344e41]">Ubicación</p>
                        <p>Calle Principal S/N, Paraíso, Tabasco, México.</p>
                    </div>
                </div>
                <div class="flex items-start">
                    <span class="text-2xl mr-4">📞</span>
                    <div>
                        <p class="font-bold text-[#344e41]">Teléfono</p>
                        <p>+52 (933) 123 4567</p>
                    </div>
                </div>
                <div class="flex items-start">
                    <span class="text-2xl mr-4">⏰</span>
                    <div>
                        <p class="font-bold text-[#344e41]">Horario</p>
                        <p>Lunes a Domingo: 9:00 AM - 10:00 PM</p>
                    </div>
                </div>
            </div>

            <!-- Map Placeholder -->
            <div
                class="mt-8 h-64 bg-gray-300 rounded-xl overflow-hidden shadow-md"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3762.5363787755!2d-93.2144!3d18.4000!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTjCsDI0JzAwLjAiTiA5M8KwMTInNTEuOCJX!5e0!3m2!1ses!2smx!4v1620000000000!5m2!1ses!2smx"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                >
                </iframe>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white p-8 rounded-2xl shadow-xl">
            <h2 class="text-3xl font-serif font-bold text-[#3a5a40] mb-6">
                Envíanos un mensaje
            </h2>
            <form class="space-y-6">
                <div>
                    <label
                        for="name"
                        class="block text-sm font-medium text-gray-700 mb-1"
                        >Nombre</label
                    >
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-[#588157] focus:border-[#588157] outline-none transition-colors"
                        placeholder="Tu nombre"
                        required
                    />
                </div>
                <div>
                    <label
                        for="email"
                        class="block text-sm font-medium text-gray-700 mb-1"
                        >Correo Electrónico</label
                    >
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-[#588157] focus:border-[#588157] outline-none transition-colors"
                        placeholder="tucorreo@ejemplo.com"
                        required
                    />
                </div>
                <div>
                    <label
                        for="message"
                        class="block text-sm font-medium text-gray-700 mb-1"
                        >Mensaje</label
                    >
                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-[#588157] focus:border-[#588157] outline-none transition-colors"
                        placeholder="¿En qué podemos ayudarte?"
                        required></textarea>
                </div>
                <button
                    type="submit"
                    class="w-full bg-[#588157] text-white font-bold py-3 rounded-lg hover:bg-[#3a5a40] transition-colors duration-300 shadow-md"
                >
                    Enviar Mensaje
                </button>
            </form>
        </div>
    </div>
</BaseLayout>
