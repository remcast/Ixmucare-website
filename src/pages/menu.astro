---
import BaseLayout from "../layouts/baseLayout.astro";
const pageTitle = "Menú | Restaurante Ixmucare";

const menuCategories = [
    {
        title: "Entradas",
        items: [
            {
                name: "Ceviche Ixmucare",
                description:
                    "Pescado fresco marinado en cítricos con el toque secreto.",
                price: "$180",
            },
            {
                name: "Coctel de Camarón",
                description: "Camarones frescos en salsa coctelera de la casa.",
                price: "$160",
            },
            {
                name: "Empanadas de Minilla",
                description:
                    "3 piezas de empanadas rellenas de minilla de pescado.",
                price: "$120",
            },
        ],
    },
    {
        title: "Platos Fuertes",
        items: [
            {
                name: "Mojarra Frita",
                description:
                    "Mojarra fresca frita al mojo de ajo o a la diabla.",
                price: "$220",
            },
            {
                name: "Camarones al Coco",
                description: "Empanizados con coco y salsa de mango.",
                price: "$240",
            },
            {
                name: "Filete Relleno de Mariscos",
                description: "Filete de pescado relleno de jaiba y camarón.",
                price: "$280",
            },
            {
                name: "Pejelagarto Asado",
                description: "Tradicional pejelagarto asado a la leña.",
                price: "$300",
            },
        ],
    },
    {
        title: "Bebidas",
        items: [
            {
                name: "Pozol con Cacao",
                description: "Bebida típica de Tabasco, bien fría.",
                price: "$40",
            },
            {
                name: "Agua de Matali",
                description: "Refrescante agua de matali con limón.",
                price: "$35",
            },
            {
                name: "Cerveza Nacional",
                description: "Variedad de cervezas nacionales.",
                price: "$45",
            },
        ],
    },
];
---

<BaseLayout pageTitle={pageTitle}>
    <section class="bg-[#dad7cd] py-16 text-center">
        <h1
            class="text-4xl md:text-6xl font-serif font-bold text-[#344e41] mb-4"
        >
            Nuestro Menú
        </h1>
        <p class="text-xl text-[#588157]">
            Sabores auténticos de la costa tabasqueña
        </p>
    </section>

    <div class="max-w-4xl mx-auto px-4 py-16">
        {
            menuCategories.map((category) => (
                <div class="mb-16">
                    <h2 class="text-3xl font-serif font-bold text-[#3a5a40] mb-8 border-b-2 border-[#a3b18a] pb-2 inline-block">
                        {category.title}
                    </h2>
                    <div class="grid gap-8 md:grid-cols-2">
                        {category.items.map((item) => (
                            <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow border-l-4 border-[#588157]">
                                <div class="flex justify-between items-baseline mb-2">
                                    <h3 class="text-xl font-bold text-[#344e41]">
                                        {item.name}
                                    </h3>
                                    <span class="text-lg font-bold text-[#a3b18a]">
                                        {item.price}
                                    </span>
                                </div>
                                <p class="text-gray-600 italic">
                                    {item.description}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</BaseLayout>
