---
import BaseLayout from "../layouts/baseLayout.astro";
import SlideMenu from "../components/SlideMenu.astro";
const pageTitle = "Menú | Restaurante Ixmucare";
---

<BaseLayout pageTitle={pageTitle}>
    <section class="max-w-5xl mx-auto mt-10 px-4 text-center">
        <h1 class="text-4xl font-bold uppercase tracking-wide text-stone-900">
            Nuestro menú
        </h1>
        <div class="border-b-2 mt-4 mb-4 mx-auto w-84 border-lime-600"></div>
        <p class="text-lg max-w-2xl mx-auto text-stone-600">Explora nuestra variedad de mariscos frescos, especialidades locales y comida tradicional tabasqueña preparada al momento.</p>
    </section>
    <SlideMenu/>
</BaseLayout>
