---
import BaseLayout from "../layouts/baseLayout.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
const pageTitle = "Restaurante Ixmucare | Restaurante en Paraíso";
---

<BaseLayout pageTitle={pageTitle}>

<Hero/>

<section class="max-w-2xl mx-auto md:max-w-6xl py-4 px-4 mb-2 bg-stone-50">
    <div class="flex flex-col justify-center items-center text-center">
        <h3 class="text-2xl font-medium mb-2">
            Explora nuestro menú
        </h3>
        <p class="text-stone-600 mb-8"> 
            Descubre una selección de platillos preparados con ingredientes frescos y el auténtico sazón de Paraíso.
        </p>

        <a href="../menu" class="border-2 border-lime-300 hover:bg-lime-300 hover:text-white rounded-3xl p-4">
            VER MENÚ
        </a>
    </div>
    {/*fotos */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        <article class="rounded-2xl overflow-hidden shadow-lg max-w-sm mx-auto w-full">
            <img
                src="/platillo-ixmucare-paraiso.jpg"
                alt="paltillo"
                width="800"
                height="800"
                class="w-full aspect-square object-cover"
            />
        </article>

        <article class="hidden md:block rounded-2xl overflow-hidden shadow-lg max-w-sm mx-auto w-full">
            <img
                src="/coctel.jpg"
                alt="paltillo"
                width="800"
                height="800"
                class="w-full aspect-square object-cover"
            />
        </article>

                <article class="hidden md:block rounded-2xl overflow-hidden shadow-lg max-w-sm mx-auto w-full">
            <img
                src="/posta.jpg"
                alt="paltillo"
                width="800"
                height="800"
                class="w-full aspect-square object-cover"
            />
        </article>
    </div>  
</section>

<section class="max-w-full mx-auto grid grid-cols-1 md:grid-cols-2 px-4 md:px-14 p-10 bg-amber-200  justify-center">
    <div class="max-w-2xs mx-auto mb-8 md:mb-0 text-center flex flex-col">
        <h3 class="text-2xl text-stone-900 uppercase font-medium mb-4 ">
            Acerca de Ixmucare..
        </h3>
        <p class="text-stone-600 mb-8">
            Instalaciones de estilo ecoturístico. El ambiente más fresco para relajarte en familia o con amigos.
        </p>
        <a href="/about.astro" class="p-5 mb:mt-8 bg-stone-900 text-white rounded-3xl">
            Saber más
        </a>
    </div>

    <img src="/interior.jpg"
        class="rounded-2xl shadow-lg mt-4 md:mt-0"/>
</section>