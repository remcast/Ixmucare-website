---
import BaseLayout from "../layouts/baseLayout.astro";
import Hero from "../components/Hero.astro";
import SlideMenu from "../components/SlideMenu.astro";
const pageTitle = "Restaurante Ixmucare | Restaurante en Paraíso";
---

<BaseLayout pageTitle={pageTitle}>

<Hero/>

<section class="max-w-2xl mx-auto py-10 px-4">
    <div class="flex flex-col justify-center items-center text-center">
        <h3 class="text-2xl font-medium mb-2">
            Explora nuestro menú
        </h3>
        <p class="text-stone-600 mb-4"> 
            Descubre una selección de platillos preparados con ingredientes frescos y el auténtico sazón de Paraíso.
        </p>
        <button class="border border-lime-600 rounded-3xl p-4">
            <a href="../menu">
                VER MENÚ
            </a>
        </button>
    </div>
</section>
