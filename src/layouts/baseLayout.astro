---
const { 
  pageTitle = "Restaurante Ixmucare | Mariscos y Comida Tradicional en Paraíso, Tabasco",
  pageDescription = "El mejor restaurante familiar en Paraíso, Tabasco. Disfruta de mariscos frescos, coctelería, pescados y cocina tradicional cerca de Puerto Ceiba y Dos Bocas."
} = Astro.props;
// Genera automáticamente la URL exacta de la página actual (ej. /menu o /contact)
const canonicalURL = new URL(Astro.url.pathname, "https://ixmucare.netlify.app");
const socialImageURL = new URL("/interior.jpg", "https://ixmucare.netlify.app");
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        
        <!-- SEO Principal -->
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Geo-tags para SEO Local en Tabasco -->
        <meta name="geo.region" content="MX-TAB" />
        <meta name="geo.placename" content="Paraíso, Tabasco" />
        <meta name="geo.position" content="18.3983;-93.2125" />
        <meta name="ICBM" content="18.3983, -93.2125" />

        <!-- Open Graph / WhatsApp / Facebook -->
        <meta property="og:type" content="restaurant" />
        <meta property="og:locale" content="es_MX" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={socialImageURL} />

        <!-- Schema.org JSON-LD enriquecido para superar a la competencia local -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Restaurant",
                "name": "Restaurante Ixmucare",
                "description": "Restaurante familiar de mariscos frescos y comida tradicional tabasqueña en Paraíso, Tabasco.",
                "image": [
                    "https://ixmucare.netlify.app/interior.jpg",
                    "https://ixmucare.netlify.app/coctel.jpg"
                ],
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Calle Ixmucare, Sección Tanques",
                    "addressLocality": "Paraíso",
                    "addressRegion": "Tabasco",
                    "postalCode": "86620",
                    "addressCountry": "MX"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": 18.3983,
                    "longitude": -93.2125
                },
                "url": "https://ixmucare.netlify.app/",
                "hasMenu": "https://ixmucare.netlify.app/menu",
                "telephone": "+529331234567",
                "servesCuisine": ["Mariscos", "Comida Mexicana", "Cocina Tradicional Tabasqueña"],
                "priceRange": "$$",
                "openingHoursSpecification": [
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": [
                            "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
                        ],
                        "opens": "10:00",
                        "closes": "19:00"
                    }
                ],
                "acceptsReservations": "True"
            }
        </script>
    </head>
    <body class="bg-stone-50 text-stone-900 font-sans antialiased min-h-screen flex flex-col">
        <Header />
        <main class="flex-grow">
            <slot />
        </main>
        <Footer />
        <script>
            import "../scripts/menu.js";
        </script>
    </body>
</html>
